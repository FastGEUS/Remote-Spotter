[Unit]
Description=TinyPedal Remote Spotter prototype
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=spotter
Group=spotter
WorkingDirectory=/opt/tinypedal-remote
Environment=SPOTTER_ROOT=/opt/tinypedal-remote
Environment=SPOTTER_PYTHON=/opt/tinypedal-remote/.venv/bin/python
Environment=SPOTTER_ADDR=127.0.0.1:8080
Environment=SPOTTER_STATE_DIR=/var/lib/spotter
StateDirectory=spotter
StateDirectoryMode=0700
EnvironmentFile=/etc/spotter/credentials.env
ExecStart=/opt/tinypedal-remote/relay/spotter-relay
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TasksMax=64
MemoryMax=700M
UMask=0077

[Install]
WantedBy=multi-user.target
